{
  "description": "Tell each session where the local Obsidian vault is (read-only pointer).",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "command -v python3 >/dev/null 2>&1 && python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/vault_pointer.py\" || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
